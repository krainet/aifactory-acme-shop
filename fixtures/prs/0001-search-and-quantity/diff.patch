diff --git a/tests/test_api_search_quantity.py b/tests/test_api_search_quantity.py
new file mode 100644
index 0000000..3b1aecc
--- /dev/null
+++ b/tests/test_api_search_quantity.py
@@ -0,0 +1,16 @@
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+
+def test_search_finds_products_by_name(client: TestClient) -> None:
+    response = client.get("/products/search", params={"q": "anv"})
+    assert response.status_code == 200
+    assert [product["sku"] for product in response.json()] == ["ACME-ANV-001"]
+
+
+def test_set_quantity_replaces_the_line_quantity(client: TestClient) -> None:
+    client.post("/cart/c1/items", json={"product_id": 1, "quantity": 1})
+    response = client.put("/cart/c1/items/1", json={"quantity": 5})
+    assert response.status_code == 200
+    assert response.json() == {"product_id": 1, "quantity": 5}
